# External API
COINGECKO_API_KEY=your_coingecko_api_key_here

# Neon Postgres
DATABASE_URL=your_neon_database_url_here
DATABASE_URL_UNPOOLED=your_neon_unpooled_database_url_here

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
